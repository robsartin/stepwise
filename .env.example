# Speech-to-text provider key (exposed to the client via Vite).
# Copy this file to `.env.local` and fill in your key. Never commit `.env.local`.
VITE_STT_API_KEY=

# Anthropic API key used by the gated live test (RUN_LIVE_API=1), host-side / Node only.
ANTHROPIC_API_KEY=

# Anthropic API key for in-app AI recipe generation. The plugin runs entirely on the
# glasses client, so this is shipped to the client via Vite — use a minimally-scoped
# personal/demo key, and leave it unset to disable in-app generation.
VITE_ANTHROPIC_API_KEY=
